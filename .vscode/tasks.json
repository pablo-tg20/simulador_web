{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "instalar",
      "detail": "Crea el venv, instala FastAPI y React/Vite (npm run instalar)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "instalar"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "API (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true, "focus": false },
      "problemMatcher": []
    },
    {
      "label": "WEB (Vite)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true, "focus": false },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "detail": "Arranca backend y frontend en el terminal integrado",
      "dependsOn": ["API (FastAPI)", "WEB (Vite)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "pruebas",
      "detail": "Pruebas automáticas de la API y casos de la rúbrica (npm test)",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "stop",
      "detail": "Detiene backend (8000) y frontend (5173)",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "${workspaceFolder}\\stop.bat"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    }
  ]
}
